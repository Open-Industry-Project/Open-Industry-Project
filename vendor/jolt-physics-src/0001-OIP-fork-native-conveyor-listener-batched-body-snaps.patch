diff --git a/JoltJS.h b/JoltJS.h
index 12b675a..7f30697 100644
--- a/JoltJS.h
+++ b/JoltJS.h
@@ -869,3 +869,217 @@ public:
 	/// Value used to create gaps in the height field
 	static constexpr float	cNoCollisionValue = HeightFieldShapeConstants::cNoCollisionValue;
 };
+
+/// A fully-native ContactListener for conveyor simulation (github.com/<oip> fork addition).
+///
+/// Replaces a per-contact JS listener whose WASM->JS crossings dominate step cost at industrial
+/// contact counts (and which the multithreaded build cannot run at all: contact callbacks fire on
+/// pthread job threads, whose isolated JS realms don't hold the listener object).
+///
+/// Contract with JS:
+/// - The listener owns a fixed-capacity facet table (8 doubles per slot:
+///   [kind (0 unused / 1 linear / 2 arc), vx, vy, vz, omega, cx, cz, reserved]).
+///   JS allocates slots itself and writes velocities through a Float64Array view over
+///   GetFacetTablePtr(); writes must happen outside PhysicsSystem::Update (the app writes
+///   between steps on its physics thread). The listener only reads.
+/// - A conveyor body advertises its facets in its (32-bit) user data:
+///   bit 31 = conveyor tag, bits 12..30 = base slot, bits 0..11 = entry count.
+///   count == 0 participates in ghost filtering only (e.g. conveying rigs' frame rails).
+///   count == 1 uses the base slot directly; count > 1 resolves the contacted facet via the
+///   leaf shape's 1-based user data (Shape::GetSubShapeUserData), mirroring the JS layout.
+/// - Ghost gates: a contact that is a speculative ghost (separation beyond inGhostMinSeparation
+///   with normal lift below inGhostSpecUpDot) or a shallow sideways ram (depth <= inGhostRamDepth
+///   with lift <= inGhostRamUpDot) has its mass/inertia zeroed instead of resolving.
+/// - Otherwise the facet surface velocities are summed (body1 negative, body2 positive; arc
+///   entries re-based about body 1's COM) into the contact's relative surface velocities.
+class ConveyorContactListener : public ContactListener
+{
+public:
+							ConveyorContactListener(unsigned int inCapacity, float inGhostMinSeparation, float inGhostSpecUpDot, float inGhostRamDepth, float inGhostRamUpDot) :
+		mGhostMinSeparation(inGhostMinSeparation),
+		mGhostSpecUpDot(inGhostSpecUpDot),
+		mGhostRamDepth(inGhostRamDepth),
+		mGhostRamUpDot(inGhostRamUpDot)
+	{
+		mFacets.resize((size_t)inCapacity * cStride, 0.0);
+	}
+
+	unsigned int			GetFacetCapacity() const
+	{
+		return (unsigned int)(mFacets.size() / cStride);
+	}
+
+	/// WASM address of the facet table, for JS to overlay a Float64Array view
+	unsigned int			GetFacetTablePtr() const
+	{
+		return (unsigned int)(uintptr_t)mFacets.data();
+	}
+
+	/// Couple torsional friction to tangential friction on DRIVEN deck contacts only (see
+	/// ContactSettings::mFrictionCoupling). 0 = off (stock Jolt behavior), 1 = fully coupled.
+	/// Cargo stalled against an obstruction has spent its traction dragging forward, so without
+	/// this it still resists yaw at full strength and cannot pivot off the thing it caught on.
+	void					SetFrictionCoupling(float inCoupling)
+	{
+		mFrictionCoupling = inCoupling;
+	}
+
+	virtual void			OnContactAdded(const Body &inBody1, const Body &inBody2, const ContactManifold &inManifold, ContactSettings &ioSettings) override
+	{
+		HandleContact(inBody1, inBody2, inManifold, ioSettings);
+	}
+
+	virtual void			OnContactPersisted(const Body &inBody1, const Body &inBody2, const ContactManifold &inManifold, ContactSettings &ioSettings) override
+	{
+		HandleContact(inBody1, inBody2, inManifold, ioSettings);
+	}
+
+private:
+	static constexpr size_t	cStride = 8;
+	static constexpr uint64	cConveyorTag = 0x80000000ull;
+
+	inline const double *	ResolveFacet(const Body &inBody, uint64 inUserData, const SubShapeID &inSubShapeID) const
+	{
+		uint32 count = (uint32)(inUserData & 0xfffull);
+		if (count == 0)
+			return nullptr;
+		uint32 base = (uint32)((inUserData >> 12) & 0x7ffffull);
+		if (count == 1)
+			return &mFacets[(size_t)base * cStride];
+		uint64 u = inBody.GetShape()->GetSubShapeUserData(inSubShapeID);
+		if (u < 1 || u > count)
+			return nullptr;
+		return &mFacets[((size_t)base + (size_t)u - 1) * cStride];
+	}
+
+	void					HandleContact(const Body &inBody1, const Body &inBody2, const ContactManifold &inManifold, ContactSettings &ioSettings)
+	{
+		uint64 u1 = inBody1.GetUserData();
+		uint64 u2 = inBody2.GetUserData();
+		bool conveyor1 = (u1 & cConveyorTag) != 0;
+		bool conveyor2 = (u2 & cConveyorTag) != 0;
+		if (!conveyor1 && !conveyor2)
+			return;
+
+		// mWorldSpaceNormal points from body 1 to body 2; flip it when the dynamic cargo is
+		// body 1 (i.e. the conveyor is body 2) so upDot measures the normal's lift on the box
+		float ny = inManifold.mWorldSpaceNormal.GetY();
+		float up_dot = conveyor1 ? ny : -ny;
+		float depth = inManifold.mPenetrationDepth;
+		bool speculative_ghost = depth < -mGhostMinSeparation && up_dot < mGhostSpecUpDot;
+		bool shallow_ram_ghost = depth <= mGhostRamDepth && up_dot <= mGhostRamUpDot;
+		if (speculative_ghost || shallow_ram_ghost)
+		{
+			ioSettings.mInvMassScale1 = 0.0f;
+			ioSettings.mInvMassScale2 = 0.0f;
+			ioSettings.mInvInertiaScale1 = 0.0f;
+			ioSettings.mInvInertiaScale2 = 0.0f;
+			return;
+		}
+
+		const double *e1 = conveyor1 ? ResolveFacet(inBody1, u1, inManifold.mSubShapeID1) : nullptr;
+		const double *e2 = conveyor2 ? ResolveFacet(inBody2, u2, inManifold.mSubShapeID2) : nullptr;
+		if (e1 == nullptr && e2 == nullptr)
+			return;
+
+		double vx = 0.0, vy = 0.0, vz = 0.0, wy = 0.0, c1x = 0.0, c1z = 0.0;
+		if ((e1 != nullptr && e1[0] == 2.0) || (e2 != nullptr && e2[0] == 2.0))
+		{
+			// Jolt applies the angular surface velocity about body 1's COM; the linear term
+			// re-bases the rotation onto the arc center so the surface velocity at every
+			// contact point is omega x (p - center)
+			RVec3 com1 = inBody1.GetCenterOfMassPosition();
+			c1x = (double)com1.GetX();
+			c1z = (double)com1.GetZ();
+		}
+		auto add = [&](const double *e, double s)
+		{
+			if (e == nullptr || e[0] == 0.0)
+				return;
+			if (e[0] == 1.0)
+			{
+				vx += s * e[1];
+				vy += s * e[2];
+				vz += s * e[3];
+			}
+			else
+			{
+				wy += s * e[4];
+				vx += s * e[4] * (c1z - e[6]);
+				vz -= s * e[4] * (c1x - e[5]);
+			}
+		};
+		add(e1, -1.0);
+		add(e2, 1.0);
+		ioSettings.mRelativeLinearSurfaceVelocity = Vec3((float)vx, (float)vy, (float)vz);
+		ioSettings.mRelativeAngularSurfaceVelocity = Vec3(0.0f, (float)wy, 0.0f);
+		// Only DRIVEN facets get here: the ghost gates returned above, and a registered-but-undriven
+		// body (a conveying rig's frame rail, count 0) resolves to no facet and returns as well.
+		ioSettings.mFrictionCoupling = mFrictionCoupling;
+	}
+
+	Array<double>			mFacets;
+	float					mGhostMinSeparation;
+	float					mGhostSpecUpDot;
+	float					mGhostRamDepth;
+	float					mGhostRamUpDot;
+	float					mFrictionCoupling = 0.0f;
+};
+
+/// Batched body-state snapshot (OIP fork addition): one WASM call fills a flat float buffer with
+/// [pos.x, pos.y, pos.z, quat.x, quat.y, quat.z, quat.w] per requested body, replacing the ~9
+/// WASM->JS getter crossings per body per frame that the frame walk (and per-beam sensor queries)
+/// otherwise pay. JS writes BodyID raw values (GetIndexAndSequenceNumber) into the ids buffer,
+/// calls Fill(system, count), and reads the output buffer via a Float32Array view. Read-only and
+/// called outside PhysicsSystem::Update from the physics thread — same access pattern as the
+/// getter walk it replaces (GetBodyInterfaceNoLock).
+class BodySnapshot
+{
+public:
+							BodySnapshot(unsigned int inCapacity)
+	{
+		mIds.resize(inCapacity);
+		mOut.resize((size_t)inCapacity * 7);
+	}
+
+	unsigned int			GetCapacity() const
+	{
+		return (unsigned int)mIds.size();
+	}
+
+	/// WASM address of the BodyID input buffer (uint32 per body), for a Uint32Array view
+	unsigned int			GetIdsPtr() const
+	{
+		return (unsigned int)(uintptr_t)mIds.data();
+	}
+
+	/// WASM address of the output buffer (7 floats per body), for a Float32Array view
+	unsigned int			GetOutPtr() const
+	{
+		return (unsigned int)(uintptr_t)mOut.data();
+	}
+
+	void					Fill(PhysicsSystem *inSystem, unsigned int inCount)
+	{
+		BodyInterface &bi = inSystem->GetBodyInterfaceNoLock();
+		unsigned int n = inCount < (unsigned int)mIds.size() ? inCount : (unsigned int)mIds.size();
+		for (unsigned int i = 0; i < n; i++)
+		{
+			RVec3 p;
+			Quat q;
+			bi.GetPositionAndRotation(BodyID(mIds[i]), p, q);
+			float *o = &mOut[(size_t)i * 7];
+			o[0] = (float)p.GetX();
+			o[1] = (float)p.GetY();
+			o[2] = (float)p.GetZ();
+			o[3] = q.GetX();
+			o[4] = q.GetY();
+			o[5] = q.GetZ();
+			o[6] = q.GetW();
+		}
+	}
+
+private:
+	Array<uint32>			mIds;
+	Array<float>			mOut;
+};
