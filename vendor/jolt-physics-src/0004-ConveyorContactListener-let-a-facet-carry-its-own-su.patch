From afd20796d899a4d045500683b2c5cdae1dc3fe9e Mon Sep 17 00:00:00 2001
From: ryevdokimov <105675984+ryevdokimov@users.noreply.github.com>
Date: Fri, 23 Oct 2026 14:07:37 -0400
Subject: [PATCH] ConveyorContactListener: let a facet carry its own surface
 friction

---
 JoltJS.h | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/JoltJS.h b/JoltJS.h
index 51027de..0e4e409 100644
--- a/JoltJS.h
+++ b/JoltJS.h
@@ -878,7 +878,7 @@ public:
 ///
 /// Contract with JS:
 /// - The listener owns a fixed-capacity facet table (16 doubles per slot:
-///   [kind (0 unused / 1 linear / 2 arc), vx, vy, vz, omega, cx, cz, nx, ny, nz, fx, fy, fz, x3]).
+///   [kind (0 unused / 1 linear / 2 arc), vx, vy, vz, omega, cx, cz, nx, ny, nz, fx, fy, fz, friction, x2]).
 ///   JS allocates slots itself and writes velocities through a Float64Array view over
 ///   GetFacetTablePtr(); writes must happen outside PhysicsSystem::Update (the app writes
 ///   between steps on its physics thread). The listener only reads.
@@ -899,6 +899,9 @@ public:
 ///   share a signature with a wall (horizontal normal, shallow penetration) that lift alone cannot
 ///   separate. A face perpendicular to BOTH the surface and the flow is a side wall, never a ghost;
 ///   see SetFlankProtectCos, which is off unless set.
+/// - friction is the facet's own surface friction, combined with the other body's as Jolt combines two
+///   bodies' (sqrt(a * b)) in place of the conveyor body's value, for a body whose facets grip differently.
+///   0 means none, so a table written by an older caller behaves exactly as it did before this field existed.
 /// - A conveyor body advertises its facets in its (32-bit) user data:
 ///   bit 31 = conveyor tag, bits 12..30 = base slot, bits 0..11 = entry count.
 ///   count == 0 participates in ghost filtering only (e.g. conveying rigs' frame rails).
@@ -1106,6 +1109,12 @@ private:
 		// Only DRIVEN facets get here: the ghost gates returned above, and a registered-but-undriven
 		// body (a conveying rig's frame rail, count 0) resolves to no facet and returns as well.
 		ioSettings.mFrictionCoupling = mFrictionCoupling;
+		// A facet with its own friction (slot 13, a merged deck's member; 0 = none) combines it with the
+		// cargo's as Jolt combines two bodies', in place of the deck body's single value.
+		if (e1 != nullptr && e1[13] > 0.0)
+			ioSettings.mCombinedFriction = sqrt((float)e1[13] * inBody2.GetFriction());
+		else if (e2 != nullptr && e2[13] > 0.0)
+			ioSettings.mCombinedFriction = sqrt((float)e2[13] * inBody1.GetFriction());
 	}
 
 	Array<double>			mFacets;
-- 
