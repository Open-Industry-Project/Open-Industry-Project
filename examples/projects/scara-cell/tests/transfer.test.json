{
  "name": "Both SCARA robots transfer cartons in parallel from infeed A to outfeed B: >= 16 delivered in 40 s, both active, none on the floor",
  "duration": 40,
  "inputs": [
    { "at": 0.2, "tag": "StartPB", "value": true },
    { "at": 0.4, "tag": "StartPB", "value": false }
  ],
  "checks": [
    { "eventually": true, "tag": "Delivered", "min": 16 },
    { "eventually": true, "min": 16,
      "probe": { "passed": { "zone": { "min": [-0.51, 0.85, -1.55], "max": [-0.19, 1.2, -1.50] } } } },
    { "at": 39.9, "tag": "Picked1", "min": 8 },
    { "at": 39.9, "tag": "Picked2", "min": 8 },
    { "always": true, "max": 0,
      "probe": { "count": { "zone": { "min": [-3, -1, -3], "max": [3, 0.6, 3] } } } },
    { "always": true, "max": 1,
      "probe": { "count": { "zone": { "min": [0.20, 0.85, 0.31], "max": [0.50, 1.0, 0.90] } } } },
    { "always": true, "max": 1,
      "probe": { "count": { "zone": { "min": [0.20, 0.85, -0.60], "max": [0.50, 1.0, 0.10] } } } },
    { "always": true, "tag": "Delivered", "max": { "tag": "Picked" } },
    { "always": true, "from": 0.1, "tag": "EStopOk", "equals": true }
  ]
}
